{
  "name": "abyssforge",
  "version": "0.1.0",
  "description": "A browser-based 2D expedition sandbox about mining, crafting, procedural horizons, light survival, and hidden meta-lore.",
  "main": "index.html",
  "scripts": {
    "assets:all": "npm run assets:fetch && npm run assets:build-runtime && npm run assets:audit",
    "assets:audit": "node scripts/audit-external-assets.js",
    "assets:build-runtime": "node scripts/build-external-asset-data.js",
    "assets:fetch": "node scripts/fetch-external-assets.js",
    "docs:screenshots": "node scripts/capture-readme-images.js",
    "test": "npm run test:spawn && npm run test:perf",
    "test:spawn": "node scripts/verify-spawn-seeds.js",
    "test:perf": "node scripts/verify-hud-performance.js"
  },
  "keywords": [
    "phaser",
    "browser-game",
    "mining",
    "crafting",
    "survival",
    "pixel-art",
    "procedural-generation",
    "metroidvania",
    "sandbox"
  ],
  "author": "RiseFox",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/RiseFox/abyssforge.git"
  },
  "bugs": {
    "url": "https://github.com/RiseFox/abyssforge/issues"
  },
  "homepage": "https://github.com/RiseFox/abyssforge#readme",
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
